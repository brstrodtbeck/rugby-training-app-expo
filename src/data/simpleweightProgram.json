        {"name": "Dynamic Mobility", "duration": "3-5 min", "exercises": ["Arm Circles (10 each direction)", "Leg Swings (10 each)", "Hip Circles (10 each)", "Cat-Cow (10 reps)", "Bodyweight Squats (10)"]},
