        {"name": "Easy Movement", "duration": "3 min", "cue": "Light walk or easy bike to bring heart rate down"},
        {"name": "Static Stretching", "duration": "8-10 min", "exercises": [
          {"name": "Hamstrings", "duration": "60s each", "cue": "Standing or seated toe touch"},
          {"name": "Quads", "duration": "60s each", "cue": "Standing quad stretch or couch stretch"},
          {"name": "Hip Flexors", "duration": "60s each", "cue": "Half-kneeling with glute squeeze"},
          {"name": "Chest/Shoulders", "duration": "60s", "cue": "Doorway stretch both arms"}
        ]},
        {"name": "Breathing Reset", "duration": "2 min", "cue": "Lie down, slow deep breaths, let body relax"}
      ]
    },
    "activeRecovery": {
      "name": "Active Recovery Day",
      "duration": "25-35 min",
      "description": "Light movement between training days",
      "steps": [
