{
  "expo": {
    "name": "RepDrive",
    "slug": "brstr",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E0E0E0"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.progressiveoverlord.app",
      "buildNumber": "11",
      "infoPlist": {
        "NSCameraUsageDescription": "This app may use the camera for exercise form analysis.",
        "NSPhotoLibraryUsageDescription": "This app may access photos to save workout progress images."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E0E0E0"
      },
      "package": "com.progressiveoverlord.app",
      "versionCode": 5,
      "permissions": [
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e7473b32-6477-4df9-b016-3227b603b30b"
      },
      "firebase": {
        "apiKey": "",
        "authDomain": "",
        "projectId": "",
        "storageBucket": "",
        "messagingSenderId": "",
        "appId": ""
      }
    },
    "owner": "brstrodtbeck"
  }
}
